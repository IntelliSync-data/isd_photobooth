<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_isd_photobooth_app_version_list" model="ir.ui.view">
        <field name="name">isd.photobooth.app.version.list</field>
        <field name="model">isd.photobooth.app.version</field>
        <field name="arch" type="xml">
            <list>
                <field name="version"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'enabled'"
                       decoration-danger="status == 'disabled'"/>
                <field name="package_url"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_isd_photobooth_app_version_form" model="ir.ui.view">
        <field name="name">isd.photobooth.app.version.form</field>
        <field name="model">isd.photobooth.app.version</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="version"/>
                            <field name="package_url" widget="url"/>
                        </group>
                        <group>
                            <field name="status"/>
                        </group>
                    </group>
                    <separator string="Release Notes"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_isd_photobooth_app_version_search" model="ir.ui.view">
        <field name="name">isd.photobooth.app.version.search</field>
        <field name="model">isd.photobooth.app.version</field>
        <field name="arch" type="xml">
            <search>
                <field name="version"/>
                <filter name="status_enabled" string="Enabled"
                        domain="[('status', '=', 'enabled')]"/>
                <filter name="status_disabled" string="Disabled"
                        domain="[('status', '=', 'disabled')]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_isd_photobooth_app_version" model="ir.actions.act_window">
        <field name="name">App Versions</field>
        <field name="res_model">isd.photobooth.app.version</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_isd_photobooth_app_version_search"/>
    </record>

</odoo>
