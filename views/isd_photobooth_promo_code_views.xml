<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_isd_photobooth_promo_code_list" model="ir.ui.view">
        <field name="name">isd.photobooth.promo.code.list</field>
        <field name="model">isd.photobooth.promo.code</field>
        <field name="arch" type="xml">
            <list string="Promo Codes">
                <field name="code"/>
                <field name="promotion_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'unused'"
                       decoration-danger="status == 'used'"/>
                <field name="used_time"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_isd_photobooth_promo_code_search" model="ir.ui.view">
        <field name="name">isd.photobooth.promo.code.search</field>
        <field name="model">isd.photobooth.promo.code</field>
        <field name="arch" type="xml">
            <search string="Search Promo Codes">
                <field name="code"/>
                <field name="promotion_id"/>
                <filter name="status_unused" string="Unused" domain="[('status', '=', 'unused')]"/>
                <filter name="status_used" string="Used" domain="[('status', '=', 'used')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_promotion" string="Promotion" context="{'group_by': 'promotion_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_isd_photobooth_promo_code" model="ir.actions.act_window">
        <field name="name">Promo Codes</field>
        <field name="res_model">isd.photobooth.promo.code</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_isd_photobooth_promo_code_search"/>
    </record>
</odoo>
