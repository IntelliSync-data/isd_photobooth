<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_isd_photobooth_group_list" model="ir.ui.view">
        <field name="name">isd.photobooth.group.list</field>
        <field name="model">isd.photobooth.group</field>
        <field name="arch" type="xml">
            <list string="Groups">
                <field name="name"/>
                <field name="address"/>
                <field name="managed_user_ids" widget="many2many_tags"/>
                <field name="photobooth_count" string="Booths"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_isd_photobooth_group_form" model="ir.ui.view">
        <field name="name">isd.photobooth.group.form</field>
        <field name="model">isd.photobooth.group</field>
        <field name="arch" type="xml">
            <form string="Group">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Group Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="address"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="managed_user_ids" widget="many2many_tags"/>
                            <field name="photobooth_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Photo Booths" name="photobooths">
                            <field name="photobooth_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'installed'"
                                           decoration-warning="status == 'not_yet'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isd_photobooth_group_search" model="ir.ui.view">
        <field name="name">isd.photobooth.group.search</field>
        <field name="model">isd.photobooth.group</field>
        <field name="arch" type="xml">
            <search string="Search Groups">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_isd_photobooth_group" model="ir.actions.act_window">
        <field name="name">Groups</field>
        <field name="res_model">isd.photobooth.group</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_isd_photobooth_group_search"/>
    </record>
</odoo>
