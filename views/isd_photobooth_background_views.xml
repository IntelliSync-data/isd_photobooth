<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_isd_photobooth_background_list" model="ir.ui.view">
        <field name="name">isd.photobooth.background.list</field>
        <field name="model">isd.photobooth.background</field>
        <field name="arch" type="xml">
            <list string="Backgrounds">
                <field name="image" widget="image" options="{'size': [60, 60]}"/>
                <field name="name"/>
                <field name="frame_type" widget="badge"/>
                <field name="image_url" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_isd_photobooth_background_form" model="ir.ui.view">
        <field name="name">isd.photobooth.background.form</field>
        <field name="model">isd.photobooth.background</field>
        <field name="arch" type="xml">
            <form string="Background">
                <sheet>
                    <group>
                        <group>
                            <field name="frame_type"/>
                            <field name="image" filename="image_filename"/>
                            <field name="image_filename" invisible="1"/>
                            <field name="image_url"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isd_photobooth_background_search" model="ir.ui.view">
        <field name="name">isd.photobooth.background.search</field>
        <field name="model">isd.photobooth.background</field>
        <field name="arch" type="xml">
            <search string="Search Backgrounds">
                <field name="name"/>
                <filter name="vertical" string="Vertical" domain="[('frame_type', '=', 'vertical')]"/>
                <filter name="horizontal" string="Horizontal" domain="[('frame_type', '=', 'horizontal')]"/>
                <filter name="square" string="Square" domain="[('frame_type', '=', 'square')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_frame" string="Frame Type" context="{'group_by': 'frame_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_isd_photobooth_background" model="ir.actions.act_window">
        <field name="name">Backgrounds</field>
        <field name="res_model">isd.photobooth.background</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_isd_photobooth_background_search"/>
    </record>
</odoo>
