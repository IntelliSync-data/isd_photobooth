<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="photo_download_page" name="Photo Download Page">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
                <title>Photo Download</title>
                <style>
                    @font-face {
                        font-family: 'Bandal';
                        src: url('/isd_photobooth/static/src/fonts/Bandal.ttf');
                    }
                    @font-face {
                        font-family: 'GCcommune';
                        src: url('/isd_photobooth/static/src/fonts/GCcommune.ttf');
                    }
                    @font-face {
                        font-family: 'TTNorms';
                        src: url('/isd_photobooth/static/src/fonts/TTNorms.ttf');
                    }

                    * { margin: 0; padding: 0; box-sizing: border-box; }
                    body { font-family: 'TTNorms', sans-serif; }

                    .font-bandal { font-family: 'Bandal', serif; }
                    .font-gccommune { font-family: 'GCcommune', serif; }
                    .font-ttnorms { font-family: 'TTNorms', sans-serif; }

                    .header {
                        padding: 20px;
                        padding-top: 50px;
                        text-align: center;
                        background-image: url('/isd_photobooth/static/src/img/photo_download/top1.png');
                        background-repeat: repeat-x;
                        background-position: top;
                        background-size: auto 40px;
                    }
                    .header h6 { margin: 0; }
                    .header h1 { margin: 0; }
                    .header .notice { color: #fa8fab; }
                    .header h4 { margin-bottom: 10px; }
                    .header h4:last-child { margin: 0; }

                    .content-area {
                        background-image: url('/isd_photobooth/static/src/img/photo_download/bg-download.png');
                        background-color: #969696;
                        background-position: top;
                        background-size: auto 150px;
                    }
                    .content-inner {
                        padding-top: 30px;
                        background-image: url('/isd_photobooth/static/src/img/photo_download/top2.png');
                        background-repeat: repeat-x;
                        background-position: top;
                        background-size: auto 40px;
                    }
                    .media-container {
                        max-width: 400px;
                        margin: 0 auto;
                        padding: 20px;
                    }
                    .media-container h3 {
                        color: #fff;
                        margin-bottom: 10px;
                    }
                    .media-item {
                        margin-bottom: 20px;
                    }
                    .media-item img {
                        width: 100%;
                        object-fit: contain;
                        border-radius: 4px;
                    }
                    .media-item video {
                        width: 100%;
                        max-width: 100%;
                        background: #000;
                        border-radius: 4px;
                    }
                    .btn-download {
                        display: block;
                        width: 100%;
                        margin-top: 10px;
                        padding: 10px 16px;
                        background: #1890ff;
                        color: #fff;
                        border: none;
                        border-radius: 6px;
                        font-size: 15px;
                        font-family: 'TTNorms', sans-serif;
                        cursor: pointer;
                        text-align: center;
                        text-decoration: none;
                    }
                    .btn-download:hover { background: #40a9ff; }
                    .btn-download:active { background: #096dd9; }

                    .error-page, .loading-page {
                        display: flex;
                        flex-direction: column;
                        justify-content: center;
                        align-items: center;
                        min-height: 100vh;
                        text-align: center;
                        padding: 20px;
                    }
                    .error-page { color: #666; font-size: 18px; background: #f5f5f5; }
                    .error-icon { font-size: 64px; margin-bottom: 16px; }
                    .error-title { font-size: 18px; font-weight: bold; color: #333; margin-bottom: 8px; }
                    .error-sub { font-size: 14px; color: #999; max-width: 280px; }

                    /* Modal overlay */
                    .modal-overlay {
                        display: none;
                        position: fixed;
                        top: 0; left: 0; right: 0; bottom: 0;
                        background: rgba(0,0,0,0.45);
                        z-index: 1000;
                        justify-content: center;
                        align-items: center;
                    }
                    .modal-overlay.active { display: flex; }
                    .modal-box {
                        background: #fff;
                        border-radius: 8px;
                        padding: 24px;
                        max-width: 380px;
                        width: 90%;
                        text-align: left;
                    }
                    .modal-box h3 { margin-bottom: 12px; font-size: 17px; }
                    .modal-box p { margin-bottom: 15px; font-size: 15px; }
                    .modal-box ol { padding-left: 20px; line-height: 30px; margin-bottom: 15px; }
                    .modal-box ol li { font-size: 14px; }
                    .modal-box .btn-copy {
                        display: block;
                        width: 100%;
                        padding: 10px;
                        background: #1890ff;
                        color: #fff;
                        border: none;
                        border-radius: 6px;
                        font-size: 15px;
                        cursor: pointer;
                    }
                </style>
            </head>
            <body>
                <t t-if="error">
                    <div class="error-page">
                        <div class="error-icon">
                            <t t-if="error_type == 'expired'">⏰</t>
                            <t t-elif="error_type == 'not_found'">🔍</t>
                            <t t-else="">⚠️</t>
                        </div>
                        <p class="error-title" t-esc="error"/>
                        <t t-if="error_type == 'expired'">
                            <p class="error-sub">Hình ảnh và video chỉ được lưu trữ trong 3 ngày kể từ khi chụp.</p>
                        </t>
                        <t t-if="error_type == 'not_found'">
                            <p class="error-sub">Vui lòng kiểm tra lại mã QR hoặc liên hệ nhân viên.</p>
                        </t>
                    </div>
                </t>

                <t t-if="not error">
                    <!-- Restricted WebView Modal -->
                    <div class="modal-overlay" id="browserModal">
                        <div class="modal-box font-ttnorms">
                            <h3>Hướng dẫn tải ảnh/video</h3>
                            <div id="modalIos" style="display:none;">
                                <p>Vui lòng mở link này bằng <strong style="color:#1890ff">Safari</strong> hoặc <strong style="color:#1890ff">Chrome</strong> để tải ảnh/video:</p>
                                <ol>
                                    <li>Nhấn 3 chấm (...) ở góc phải trên → Chọn <strong>"Mở bằng Safari"</strong></li>
                                    <li>Hoặc dùng <strong>Camera</strong> quét lại mã QR trên tay</li>
                                </ol>
                            </div>
                            <div id="modalAndroid" style="display:none;">
                                <p>Vui lòng mở link này bằng <strong style="color:#1890ff">Chrome</strong> để tải ảnh/video:</p>
                                <ol>
                                    <li>Nhấn 3 chấm (⋮) ở góc phải trên → Chọn <strong>"Mở bằng Chrome"</strong></li>
                                    <li>Hoặc dùng <strong>Camera</strong> quét lại mã QR trên tay</li>
                                </ol>
                            </div>
                            <div id="modalOther" style="display:none;">
                                <p>Vui lòng mở link này bằng trình duyệt để tải ảnh/video:</p>
                                <ol>
                                    <li>Nhấn 3 chấm ở góc phải trên → Chọn <strong>"Mở bằng trình duyệt"</strong></li>
                                    <li>Hoặc dùng Camera quét lại mã QR</li>
                                </ol>
                            </div>
                            <button class="btn-copy" id="btnCopyLink">Copy Link</button>
                        </div>
                    </div>

                    <!-- Header -->
                    <div class="header">
                        <h6 class="font-bandal">한국 프리미엄 포토부스</h6>
                        <h1 class="font-gccommune">k.click photo download</h1>
                        <h5 class="font-ttnorms notice">
                            Lưu ý: <b>Hình ảnh và video</b> sẽ hết hạn sau 3 ngày
                        </h5>
                        <h4 class="font-ttnorms">Quý khách vui lòng chờ 3 phút nhé</h4>
                        <h4 class="font-ttnorms">Đang tải ảnh chất lượng cao siêu xinh</h4>
                    </div>

                    <!-- Content -->
                    <div class="content-area">
                        <div class="content-inner">
                            <div class="media-container">
                                <!-- PNG Images (processed) -->
                                <t t-if="png_images">
                                    <h3>Hình Ảnh</h3>
                                    <t t-foreach="png_images" t-as="img_url">
                                        <div class="media-item">
                                            <img t-att-src="img_url" t-attf-alt="Image #{img_url_index + 1}" loading="lazy"/>
                                            <button class="btn-download js-download"
                                                    t-att-data-url="img_url"
                                                    t-attf-data-filename="image_#{img_url_index + 1}.png">
                                                ⬇ Tải hình ảnh
                                            </button>
                                        </div>
                                    </t>
                                </t>

                                <!-- JPG Images (originals) -->
                                <t t-if="jpg_images">
                                    <h3>Hình Ảnh Gốc</h3>
                                    <t t-foreach="jpg_images" t-as="img_url">
                                        <div class="media-item">
                                            <img t-att-src="img_url" t-attf-alt="Original #{img_url_index + 1}" loading="lazy"/>
                                            <button class="btn-download js-download"
                                                    t-att-data-url="img_url"
                                                    t-attf-data-filename="original_#{img_url_index + 1}.jpg">
                                                ⬇ Tải hình ảnh gốc
                                            </button>
                                        </div>
                                    </t>
                                </t>

                                <!-- Video -->
                                <t t-if="video_url">
                                    <h3>Video</h3>
                                    <div class="media-item">
                                        <video controls="controls" playsinline="playsinline"
                                               loop="loop" muted="muted"
                                               t-att-src="video_url"
                                               style="width:100%; max-width:400px; background:#000;">
                                        </video>
                                        <button class="btn-download js-download"
                                                t-att-data-url="video_url"
                                                data-filename="video.mp4">
                                            ⬇ Tải Video của bạn
                                        </button>
                                    </div>
                                </t>

                                <t t-if="not png_images and not jpg_images and not video_url">
                                    <div style="text-align:center; color:#fff; padding:40px 0;">
                                        <p class="font-ttnorms">Chưa có hình ảnh hoặc video nào.</p>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <script type="text/javascript">
                        function isRestrictedWebView() {
                            var ua = navigator.userAgent.toLowerCase();
                            return ua.indexOf('zalo') !== -1 || ua.indexOf('fbav') !== -1 || ua.indexOf('fban') !== -1;
                        }

                        function showBrowserModal() {
                            var ua = navigator.userAgent.toLowerCase();
                            var platform = 'other';
                            if (/iphone|ipad|ipod/.test(ua)) platform = 'ios';
                            else if (/android/.test(ua)) platform = 'android';

                            var ids = {ios: 'modalIos', android: 'modalAndroid', other: 'modalOther'};
                            var el = document.getElementById(ids[platform]);
                            if (el) el.style.display = 'block';

                            document.getElementById('browserModal').classList.add('active');
                        }

                        function copyLink() {
                            var url = window.location.href;
                            if (navigator.clipboard) {
                                navigator.clipboard.writeText(url).then(function() {
                                    alert('Đã copy link! Bạn có thể paste vào trình duyệt để mở.');
                                }).catch(function() {
                                    prompt('Link tải ảnh/video:', url);
                                });
                            } else {
                                prompt('Link tải ảnh/video:', url);
                            }
                        }

                        function downloadFile(url, filename) {
                            if (isRestrictedWebView()) {
                                showBrowserModal();
                                return;
                            }
                            fetch(url, { headers: { 'Cache-Control': 'no-cache' } })
                                .then(function(res) {
                                    if (!res.ok) throw new Error('HTTP ' + res.status);
                                    return res.blob();
                                })
                                .then(function(blob) {
                                    var a = document.createElement('a');
                                    a.href = URL.createObjectURL(blob);
                                    a.download = filename;
                                    document.body.appendChild(a);
                                    a.click();
                                    document.body.removeChild(a);
                                    URL.revokeObjectURL(a.href);
                                })
                                .catch(function() {
                                    window.open(url, '_blank');
                                });
                        }

                        document.addEventListener('DOMContentLoaded', function() {
                            document.querySelectorAll('.js-download').forEach(function(btn) {
                                btn.addEventListener('click', function() {
                                    downloadFile(this.dataset.url, this.dataset.filename);
                                });
                            });

                            document.getElementById('btnCopyLink').addEventListener('click', copyLink);

                            if (isRestrictedWebView()) {
                                showBrowserModal();
                            }
                        });
                    </script>
                </t>
            </body>
        </html>
    </template>
</odoo>
