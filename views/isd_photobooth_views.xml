<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_isd_photobooth_list" model="ir.ui.view">
        <field name="name">isd.photobooth.list</field>
        <field name="model">isd.photobooth</field>
        <field name="arch" type="xml">
            <list string="Photo Booths">
                <field name="name"/>
                <field name="code" widget="badge"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'installed'"
                       decoration-warning="status == 'not_yet'"/>
                <field name="group_id"/>
                <field name="printer_paper_count" string="Paper"/>
                <field name="max_prints"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_isd_photobooth_form" model="ir.ui.view">
        <field name="name">isd.photobooth.form</field>
        <field name="model">isd.photobooth</field>
        <field name="arch" type="xml">
            <form string="Photo Booth">
                <header>
                    <button name="action_install" type="object" string="Install"
                            class="btn-primary" icon="fa-check"
                            invisible="status == 'installed'"
                            confirm="Mark this booth as installed?"/>
                    <button name="action_clone" type="object" string="Clone"
                            class="btn-secondary" icon="fa-copy"/>
                    <button name="action_initialize_default_layouts" type="object"
                            string="Initialize Default Layouts" class="btn-secondary"
                            icon="fa-magic"
                            confirm="This will create 10 default layout system types. Continue?"/>
                    <button name="action_reset_printer" type="object"
                            string="Reset Printer Count" class="btn-secondary"
                            icon="fa-refresh"
                            confirm="Reset printer paper count to 0?"/>
                    <field name="status" widget="statusbar" statusbar_visible="not_yet,installed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Booth Name"/></h1>
                        <div class="o_row">
                            <label for="code"/>
                            <field name="code"/>
                        </div>
                    </div>
                    <group>
                        <group string="General">
                            <field name="group_id"/>
                            <field name="max_prints"/>
                            <field name="font_color" widget="color"/>
                            <field name="background_url"/>
                            <field name="active"/>
                        </group>
                        <group string="Payment &amp; Download">
                            <field name="payment_method" widget="json"/>
                            <field name="download_media_type" widget="json"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Layouts" name="layouts">
                            <field name="layout_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="frame_type" widget="badge"/>
                                    <field name="layout_type" widget="badge"/>
                                    <field name="price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Themes" name="themes">
                            <field name="theme_ids">
                                <list>
                                    <field name="background" widget="image" options="{'size': [60, 60]}"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Print Config" name="print_config">
                            <group>
                                <group>
                                    <field name="printer_paper_count"/>
                                </group>
                            </group>
                            <field name="layout_system_type_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="is_cut" widget="boolean"/>
                                    <field name="is_landscape" widget="boolean"/>
                                    <field name="print_width"/>
                                    <field name="print_height"/>
                                    <field name="dpi"/>
                                </list>
                            </field>
                        </page>
                        <page string="App Config" name="app_config">
                            <group>
                                <field name="config_photo_app" widget="json"/>
                            </group>
                        </page>
                        <page string="Hardware" name="hardware">
                            <group>
                                <group>
                                    <field name="hardware_health_data" widget="json" readonly="1"/>
                                </group>
                                <group>
                                    <field name="last_meta_updated_at"/>
                                    <field name="deleted_at" invisible="not deleted_at"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isd_photobooth_search" model="ir.ui.view">
        <field name="name">isd.photobooth.search</field>
        <field name="model">isd.photobooth</field>
        <field name="arch" type="xml">
            <search string="Search Photo Booths">
                <field name="name"/>
                <field name="code"/>
                <field name="group_id"/>
                <filter name="installed" string="Installed" domain="[('status', '=', 'installed')]"/>
                <filter name="not_installed" string="Not Installed" domain="[('status', '=', 'not_yet')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_location" string="Group" context="{'group_by': 'group_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_isd_photobooth" model="ir.actions.act_window">
        <field name="name">Photo Booths</field>
        <field name="res_model">isd.photobooth</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_isd_photobooth_search"/>
    </record>
</odoo>
