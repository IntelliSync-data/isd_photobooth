<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_isd_photobooth_layout_list" model="ir.ui.view">
        <field name="name">isd.photobooth.layout.list</field>
        <field name="model">isd.photobooth.layout</field>
        <field name="arch" type="xml">
            <list string="Layouts">
                <field name="image" widget="image" options="{'size': [60, 60]}"/>
                <field name="name"/>
                <field name="frame_type" widget="badge"
                       decoration-info="frame_type == '3_2'"
                       decoration-success="frame_type == '2_3'"
                       decoration-warning="frame_type == '1_1'"/>
                <field name="layout_type" widget="badge" optional="show"/>
                <field name="price"/>
                <field name="paper_size" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_isd_photobooth_layout_form" model="ir.ui.view">
        <field name="name">isd.photobooth.layout.form</field>
        <field name="model">isd.photobooth.layout</field>
        <field name="arch" type="xml">
            <form string="Layout">
                <header>
                    <button name="action_clone" type="object" string="Clone" class="btn-secondary"
                            icon="fa-copy"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Layout Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="frame_type" widget="radio"/>
                            <field name="layout_type"/>
                            <field name="price"/>
                            <field name="paper_size"/>
                        </group>
                        <group>
                            <field name="image" filename="image_filename"
                                   widget="image" options="{'size': [200, 200]}"/>
                            <field name="image_filename" invisible="1"/>
                            <field name="image_url"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Layout description..."/>
                        </page>
                        <page string="Background Colors" name="bg_colors">
                            <field name="bg_color" widget="json"/>
                        </page>
                        <page string="Backgrounds" name="backgrounds">
                            <field name="bg_layout_ids">
                                <list>
                                    <field name="image" widget="image" options="{'size': [60, 60]}"/>
                                    <field name="frame_type" widget="badge"/>
                                    <field name="image_url"/>
                                </list>
                            </field>
                        </page>
                        <page string="Themes" name="themes">
                            <field name="layout_theme_ids">
                                <list editable="bottom">
                                    <field name="theme_id"/>
                                    <field name="bg_layout_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isd_photobooth_layout_search" model="ir.ui.view">
        <field name="name">isd.photobooth.layout.search</field>
        <field name="model">isd.photobooth.layout</field>
        <field name="arch" type="xml">
            <search string="Search Layouts">
                <field name="name"/>
                <filter name="3_2" string="3:2" domain="[('frame_type', '=', '3_2')]"/>
                <filter name="2_3" string="2:3" domain="[('frame_type', '=', '2_3')]"/>
                <filter name="1_1" string="1:1" domain="[('frame_type', '=', '1_1')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_frame" string="Frame Type" context="{'group_by': 'frame_type'}"/>
                    <filter name="group_layout_type" string="Layout Type" context="{'group_by': 'layout_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_isd_photobooth_layout" model="ir.actions.act_window">
        <field name="name">Layouts</field>
        <field name="res_model">isd.photobooth.layout</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_isd_photobooth_layout_search"/>
    </record>
</odoo>
