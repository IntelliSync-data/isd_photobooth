<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_isd_photobooth_transaction_list" model="ir.ui.view">
        <field name="name">isd.photobooth.transaction.list</field>
        <field name="model">isd.photobooth.transaction</field>
        <field name="arch" type="xml">
            <list string="Transactions" default_order="date desc">
                <field name="transaction_id" widget="badge"/>
                <field name="photo_app_id"/>
                <field name="layout_id"/>
                <field name="price" sum="Total Price"/>
                <field name="real_price" sum="Total Real Price"/>
                <field name="quantity" sum="Total Qty"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-info="status == 'draft'"/>
                <field name="payment_provider" widget="badge"/>
                <field name="date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_isd_photobooth_transaction_form" model="ir.ui.view">
        <field name="name">isd.photobooth.transaction.form</field>
        <field name="model">isd.photobooth.transaction</field>
        <field name="arch" type="xml">
            <form string="Transaction">
                <header>
                    <button name="set_active" type="object" string="Set Active"
                            class="btn-primary" icon="fa-check"
                            invisible="status == 'active'"
                            confirm="Mark this transaction as active?"/>
                    <button name="action_soft_delete" type="object" string="Soft Delete"
                            class="btn-danger" icon="fa-trash"
                            confirm="Soft delete this transaction?"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="transaction_id" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="photo_app_id"/>
                            <field name="layout_id"/>
                            <field name="date"/>
                            <field name="quantity"/>
                            <field name="payment_provider"/>
                        </group>
                        <group string="Pricing">
                            <field name="price"/>
                            <field name="real_price"/>
                        </group>
                    </group>
                    <group>
                        <group string="Info">
                            <field name="group_id"/>
                            <field name="active"/>
                            <field name="deleted_on" invisible="not deleted_on"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Media" name="media">
                            <group>
                                <field name="medias" widget="json"/>
                                <field name="medias_expired_at"/>
                            </group>
                        </page>
                        <page string="Promo" name="promo">
                            <group>
                                <field name="promotion_code"/>
                                <field name="promo_code_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isd_photobooth_transaction_search" model="ir.ui.view">
        <field name="name">isd.photobooth.transaction.search</field>
        <field name="model">isd.photobooth.transaction</field>
        <field name="arch" type="xml">
            <search string="Search Transactions">
                <field name="transaction_id"/>
                <field name="photo_app_id"/>
                <field name="layout_id"/>
                <field name="promotion_code"/>
                <filter name="draft" string="Draft" domain="[('status', '=', 'draft')]"/>
                <filter name="active_status" string="Active" domain="[('status', '=', 'active')]"/>
                <separator/>
                <filter name="cash" string="Cash" domain="[('payment_provider', '=', 'cash')]"/>
                <filter name="free" string="Free" domain="[('payment_provider', '=', 'free')]"/>
                <filter name="transfer" string="Transfer" domain="[('payment_provider', '=', 'transfer')]"/>
                <filter name="topup" string="Top Up" domain="[('payment_provider', '=', 'topup')]"/>
                <filter name="promotion" string="Promotion" domain="[('payment_provider', '=', 'promotion')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('date', '&gt;=', (context_today()).strftime('%%Y-%%m-%%d')),
                                 ('date', '&lt;', (context_today() + datetime.timedelta(days=1)).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="this_week" string="This Week"
                        domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=context_today().weekday())).strftime('%%Y-%%m-%%d'))]"/>
                <filter name="this_month" string="This Month"
                        domain="[('date', '&gt;=', context_today().strftime('%%Y-%%m-01'))]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_photo_app" string="Photo Booth" context="{'group_by': 'photo_app_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_payment_provider" string="Payment Provider" context="{'group_by': 'payment_provider'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:day'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_isd_photobooth_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">isd.photobooth.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_isd_photobooth_transaction_search"/>
        <field name="context">{'search_default_active_status': 1}</field>
    </record>
</odoo>
