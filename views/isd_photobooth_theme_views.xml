<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_isd_photobooth_theme_list" model="ir.ui.view">
        <field name="name">isd.photobooth.theme.list</field>
        <field name="model">isd.photobooth.theme</field>
        <field name="arch" type="xml">
            <list string="Themes">
                <field name="background" widget="image" options="{'size': [60, 60]}"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_isd_photobooth_theme_form" model="ir.ui.view">
        <field name="name">isd.photobooth.theme.form</field>
        <field name="model">isd.photobooth.theme</field>
        <field name="arch" type="xml">
            <form string="Theme">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="background" filename="background_filename"
                                   widget="image" options="{'size': [256, 256]}"/>
                            <field name="background_filename" invisible="1"/>
                            <field name="background_url"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_isd_photobooth_theme_search" model="ir.ui.view">
        <field name="name">isd.photobooth.theme.search</field>
        <field name="model">isd.photobooth.theme</field>
        <field name="arch" type="xml">
            <search string="Search Themes">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_isd_photobooth_theme" model="ir.actions.act_window">
        <field name="name">Themes</field>
        <field name="res_model">isd.photobooth.theme</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_isd_photobooth_theme_search"/>
    </record>
</odoo>
